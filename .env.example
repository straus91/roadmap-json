# ROADMAP card creator — settings.
# Copy this file to `.env` (same folder) and fill in your key. `.env` is never committed.

# --- Required -----------------------------------------------------------------
# Your Anthropic API key (https://console.anthropic.com -> API keys).
ANTHROPIC_API_KEY=

# --- Optional (the defaults are fine) -----------------------------------------
# Which AI provider reads the papers: anthropic (default) or gemini.
LLM_PROVIDER=anthropic

# Model id. Leave empty for the provider's default:
#   anthropic -> claude-sonnet-5-5     gemini -> gemini-4-hydrogen
LLM_MODEL=

# How hard the model thinks (Anthropic only): low | medium | high | xhigh | max.
# Higher = more thorough and more expensive. medium is a good balance for papers.
LLM_EFFORT=medium

# If Fable declines a document, let Anthropic retry it on another Claude model.
# Use `off` when LLM_MODEL is not a Fable/Opus 5 model or when running through AWS Bedrock.
ANTHROPIC_FALLBACKS=default

# Only needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# How the PDF reaches the model:
#   native -> the model reads the PDF pages directly (best quality; handles tables, figures, scans)
#   text   -> the server extracts the text first (cheaper; loses figures and table layout)
PDF_MODE=native

# Largest PDF accepted, in MB.
MAX_UPLOAD_MB=20

# Port the app is served on, on this machine (http://localhost:8000 by default).
APP_PORT=8000

# Only for frontend development on another port, e.g. http://localhost:5173
CORS_ORIGINS=

# --- Spending guard -----------------------------------------------------------
# Creating cards from PDFs pauses for the rest of the month once this much has been spent
# (0 = no limit). Editing, checking and downloading cards always stay available.
MONTHLY_BUDGET_USD=50

# How many papers one visitor may process per day. 0 = no limit (the monthly budget is the only cap).
DAILY_LIMIT_PER_VISITOR=0

# Show visitors how many papers were read this month and what they cost (true/false).
# false = only you can see it: run  docker compose exec app cat /data/usage.json
SHOW_USAGE=false

# Longest PDF accepted, in pages (cost grows with pages).
MAX_PDF_PAGES=50

# Price of the model in USD per million tokens. Leave empty for the built-in list price of
# the chosen model; fill in both if you use a model the app does not know.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# --- Schema -------------------------------------------------------------------
# The schema ATLAS publishes is the authority. The app re-reads it this often (hours) and
# keeps its last good copy if ATLAS cannot be reached. 0 = never re-read (use the bundled copy).
SCHEMA_SYNC_HOURS=24

# --- Library ------------------------------------------------------------------
# The Library and Overview pages show the cards ATLAS publishes. They are read from ATLAS's
# public pages at start-up and then this often (hours); the last good copy is kept if ATLAS
# cannot be reached. 0 = never read them (the Library stays empty).
LIBRARY_SYNC_HOURS=24

# --- Send to ATLAS --------------------------------------------------------------
# Sites allowed to show this app inside their own page and receive a finished card from its
# "Send to ATLAS" button (comma-separated, e.g. https://atlas.rsna.org).
EMBED_ORIGINS=https://atlas.rsna.org
